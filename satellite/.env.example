# Copy to satellite/.env on the Raspberry Pi. Replace all example paths.
HOMESENSE_SERVER_URL=https://192.168.1.100:8443
HOMESENSE_CA_FILE=/home/pi/homesense/ca.crt
HOMESENSE_TOKEN_FILE=/home/pi/homesense/satellite-token.txt
# Download the ONNX model first, then use its actual installed path.
WAKE_MODEL=/home/pi/HomeSense/.venv/lib/python3.11/site-packages/openwakeword/resources/models/hey_jarvis_v0.1.onnx
WAKE_THRESHOLD=0.5
# Empty means the operating system's default input device.
MIC_DEVICE=
SPEECH_RMS=300
REQUEST_TIMEOUT=145

# Unique ID registered on the server; location is assigned there.
HOMESENSE_SATELLITE_ID=kitchen-pi
