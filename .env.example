# Copy to .env. Browser-only mode requires no third-party Python packages.
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
GEMINI_STT_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT=60
# true: simulate state changes without sending commands to Home Assistant.
HA_DRY_RUN=true
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
# Optional satellite HTTPS endpoint; disabled by default.
SATELLITE_ENABLED=false
# Set the server's private LAN address when enabling a satellite.
SATELLITE_BIND=127.0.0.1
SATELLITE_PORT=8443
SATELLITE_TOKEN_FILE=.secrets/satellite-token.txt
SATELLITE_TLS_CERT=.secrets/server.crt
SATELLITE_TLS_KEY=.secrets/server.key

# Per-device registry takes precedence over the legacy shared token.
SATELLITE_REGISTRY_FILE=
